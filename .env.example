# Local CPU API only. Never publish the backend or model port to the Internet.
VISITBRIEF_CASES_DIR=fixtures/cases
VISITBRIEF_HOST=127.0.0.1
VISITBRIEF_PORT=8000
VISITBRIEF_MAX_DOCUMENTS=3
VISITBRIEF_MAX_FILE_BYTES=10485760
VISITBRIEF_MAX_PAGES=20
VISITBRIEF_MAX_EXTRACTED_CHARS=200000
VISITBRIEF_MAX_BLOCK_CHARS=2000
# Leave disabled until the endpoint has been verified. Never commit the key.
# notebook: private Transformers adapter on 127.0.0.1:8001. Do not publish that port.
# token_factory: shared AMD Token Factory key (rc- + 48 hex). The whole team shares RPM and the daily cap.
VISITBRIEF_INFERENCE_ENABLED=false
VISITBRIEF_MODEL_BACKEND=notebook
VISITBRIEF_MODEL_BASE_URL=http://127.0.0.1:8001/v1
VISITBRIEF_MODEL_ID=Qwen/Qwen2.5-7B-Instruct
VISITBRIEF_MODEL_API_KEY=
VISITBRIEF_REASONING_EFFORT=
VISITBRIEF_MODEL_TIMEOUT_SECONDS=120
VISITBRIEF_MODEL_CONTEXT_TOKENS=8192
VISITBRIEF_MODEL_MAX_OUTPUT_TOKENS=2048
# Token Factory example (put the real key only in gitignored .env):
# VISITBRIEF_INFERENCE_ENABLED=true
# VISITBRIEF_MODEL_BACKEND=token_factory
# VISITBRIEF_MODEL_BASE_URL=https://developer.amd.com.cn/radeon/api/v1
# VISITBRIEF_MODEL_ID=DeepSeek-V4-Flash
# VISITBRIEF_MODEL_API_KEY=
# VISITBRIEF_REASONING_EFFORT=none
# VISITBRIEF_MODEL_TIMEOUT_SECONDS=180
# VISITBRIEF_MODEL_CONTEXT_TOKENS=32768
# VISITBRIEF_MODEL_MAX_OUTPUT_TOKENS=4096
# Optional. Needed only to download a gated model such as Llama on the AMD notebook.
HF_TOKEN=